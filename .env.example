# Optional: GitHub Personal Access Token to increase GitHub REST API rate limits
# (Default public unauthenticated limit is 60 requests/hour; with token: 5,000 requests/hour)
# Leave blank to use public unauthenticated access.
GITHUB_TOKEN=

# Optional: Local Ollama configuration for local model inference (e.g., llama3.2:3b)
# Default host is http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Network request timeout in seconds
REQUEST_TIMEOUT_SECONDS=15
