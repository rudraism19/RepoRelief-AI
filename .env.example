# RepoRelief AI Environment Configuration (100% Optional)
# By default, RepoRelief AI uses GitHub's unauthenticated public REST API.
# NO token, NO accounts, and NO setup are required to triage public repositories!

# Optional: Set a GitHub Personal Access Token ONLY if you wish to increase
# GitHub's rate limit from 60 to 5,000 requests/hour for heavy batch triage:
GITHUB_TOKEN=

# Optional: Network request timeout in seconds (default: 15)
REQUEST_TIMEOUT_SECONDS=15
